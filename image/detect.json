{
	"version": 2,
	"procfile": {
		"file": "Procfile",
		"line": "^(worker|bot)\\s*:\\s*(.+)$",
		"processes": [
			"worker",
			"bot"
		]
	},
	"serverkJson": {
		"file": "serverk.json",
		"commandLengthLimit": 1024,
		"runtimes": [
			"node",
			"python"
		],
		"platforms": [
			"discord",
			"telegram"
		],
		"frameworks": [
			"discord-js",
			"eris",
			"oceanic-js",
			"grammy",
			"telegraf",
			"node-telegram-bot-api",
			"discord-py",
			"py-cord",
			"nextcord",
			"disnake",
			"hikari",
			"python-telegram-bot",
			"aiogram",
			"pyrogram",
			"telethon"
		],
		"envLimit": 100,
		"envKey": "^[A-Za-z_][A-Za-z0-9_]*$",
		"envKeyLengthLimit": 64,
		"exampleLengthLimit": 256
	},
	"node": {
		"manifest": "package.json",
		"managerField": "packageManager",
		"berryFile": ".yarnrc.yml",
		"enginesKey": "node",
		"buildScript": "build",
		"startFiles": [
			"index.js",
			"src/index.js",
			"bot.js",
			"src/bot.js",
			"index.ts"
		],
		"lockfiles": [
			{
				"file": "pnpm-lock.yaml",
				"manager": "pnpm"
			},
			{
				"file": "bun.lock",
				"manager": "bun"
			},
			{
				"file": "bun.lockb",
				"manager": "bun"
			},
			{
				"file": "yarn.lock",
				"manager": "yarn"
			},
			{
				"file": "package-lock.json",
				"manager": "npm"
			},
			{
				"file": "npm-shrinkwrap.json",
				"manager": "npm"
			}
		],
		"installCommands": {
			"locked": {
				"npm": [
					"npm",
					"ci"
				],
				"pnpm": [
					"corepack",
					"pnpm",
					"install",
					"--frozen-lockfile"
				],
				"yarn": [
					"corepack",
					"yarn",
					"install",
					"--frozen-lockfile"
				],
				"yarn-berry": [
					"corepack",
					"yarn",
					"install",
					"--immutable"
				],
				"bun": [
					"bun",
					"install",
					"--frozen-lockfile"
				]
			},
			"unlocked": {
				"npm": [
					"npm",
					"install"
				],
				"pnpm": [
					"corepack",
					"pnpm",
					"install"
				],
				"yarn": [
					"corepack",
					"yarn",
					"install"
				],
				"yarn-berry": [
					"corepack",
					"yarn",
					"install",
					"--no-immutable"
				],
				"bun": [
					"bun",
					"install"
				]
			}
		},
		"runCommands": {
			"npm": [
				"npm",
				"run"
			],
			"pnpm": [
				"corepack",
				"pnpm",
				"run"
			],
			"yarn": [
				"corepack",
				"yarn",
				"run"
			],
			"yarn-berry": [
				"corepack",
				"yarn",
				"run"
			],
			"bun": [
				"bun",
				"run"
			]
		},
		"versionFiles": [
			{
				"file": ".nvmrc"
			},
			{
				"file": ".node-version"
			},
			{
				"file": ".tool-versions",
				"tool": "nodejs"
			}
		],
		"defaultVersion": "24"
	},
	"python": {
		"startFiles": [
			"main.py",
			"bot.py",
			"app.py",
			"src/main.py",
			"src/bot.py"
		],
		"manifests": [
			{
				"file": "requirements.txt",
				"manager": "requirements"
			},
			{
				"file": "uv.lock",
				"manager": "uv"
			},
			{
				"file": "poetry.lock",
				"manager": "poetry"
			},
			{
				"file": "pdm.lock",
				"manager": "pdm"
			},
			{
				"file": "Pipfile",
				"manager": "pipenv"
			},
			{
				"file": "pyproject.toml",
				"manager": "project"
			}
		],
		"installCommands": {
			"requirements": [
				"uv",
				"pip",
				"install",
				"-r",
				"requirements.txt"
			],
			"uv": [
				"uv",
				"sync",
				"--locked",
				"--no-dev"
			],
			"poetry": [
				"uv",
				"pip",
				"install",
				"."
			],
			"pdm": [
				"uv",
				"pip",
				"install",
				"."
			],
			"pipenv": [
				"pipenv",
				"install"
			],
			"project": [
				"uv",
				"pip",
				"install",
				"."
			]
		},
		"unhonouredManagers": [
			"poetry",
			"pdm"
		],
		"versionFiles": [
			{
				"file": ".python-version"
			},
			{
				"file": "runtime.txt",
				"prefix": "python-"
			},
			{
				"file": "Pipfile",
				"key": "python_version"
			},
			{
				"file": ".tool-versions",
				"tool": "python"
			}
		],
		"defaultVersion": "3.12"
	}
}
